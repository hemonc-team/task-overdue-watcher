# Входящий webhook Bitrix24 (prod laskov-partners). Не коммитить реальный URL.
# Должен быть выпущен от Михаила Ласкова (UID 1): пинги в задачах идут от владельца вебхука.
BITRIX24_WEBHOOK_URL=https://laskov-partners.bitrix24.ru/rest/1/CODE/

# Портал (для ссылок в отчёте). По умолчанию laskov-partners.
# BITRIX24_PORTAL=https://laskov-partners.bitrix24.ru

# Персона контроля: кому отчёт, чьи комменты в домене 2, self-ping. Prod: Ласков = 1.
WATCHER_USER_ID=1

# Охват задач. member (по умолчанию) — только где WATCHER_USER_ID участник
# (исполнитель, постановщик, соисполнитель, наблюдатель).
# all — без фильтра MEMBER: все задачи, которые видит пользователь вебхука.
# Весь портал — только если вебхук создан администратором портала.
# Первый прогон all делайте на новом state (SEED), не на старом seeded=true.
# TASK_SCOPE=all

# Путь к state.json (счётчики пингов, seeded). По умолчанию ./state.json рядом со скриптом.
# STATE_FILE=./data/state.json

# Опционально: ID файла state.json на Bitrix Disk (для cloud-прогонов).
# Агент скачивает перед прогоном и заливает после — см. docs/CURSOR_AUTOMATIONS.md
# BITRIX_DISK_STATE_FILE_ID=
