# Входящий webhook Bitrix24 (prod laskov-partners). Не коммитить реальный URL.
# В Automations допустим алиас B24_WEBHOOK_URL — скрипты принимают оба имени.
BITRIX24_WEBHOOK_URL=https://laskov-partners.bitrix24.ru/rest/USER_ID/CODE/

# Портал (для ссылок в отчёте). По умолчанию laskov-partners.
# BITRIX24_PORTAL=https://laskov-partners.bitrix24.ru

# UID владельца вебхука / кому слать отчёт. По умолчанию 1.
# WATCHER_USER_ID=1

# Путь к state.json (счётчики пингов, seeded). По умолчанию ./state.json рядом со скриптом.
# STATE_FILE=./data/state.json

# Опционально: ID файла state.json на Bitrix Disk (для cloud-прогонов).
# Агент скачивает перед прогоном и заливает после — см. docs/CURSOR_AUTOMATIONS.md
# BITRIX_DISK_STATE_FILE_ID=
